{
  "name": "@hypercerts-org/sdk-core",
  "version": "1.0.0-beta.0",
  "description": "Framework-agnostic ATProto SDK core for authentication, repository operations, and lexicon management",
  "main": "dist/index.cjs",
  "repository": {
    "url": "https://github.com/hypercerts-org/hypercerts-sdk.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "prepublishOnly": "pnpm run check",
  "scripts": {
    "test": "vitest run",
    "build": "rollup -c",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build && pnpm run test",
    "clean": "rm -rf dist",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [
    "atproto",
    "hypercerts",
    "sdk",
    "oauth",
    "decentralized"
  ],
  "author": "Hypercerts Foundation",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": ">=20.10.0",
    "jose": "^6.1.3",
    "rollup": "^4.53.3",
    "rollup-plugin-dts": "^6.2.3"
  },
  "type": "module",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.mjs",
      "require": "./dist/types.cjs"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "import": "./dist/errors.mjs",
      "require": "./dist/errors.cjs"
    },
    "./lexicons": {
      "types": "./dist/lexicons.d.ts",
      "import": "./dist/lexicons.mjs",
      "require": "./dist/lexicons.cjs"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.mjs",
      "require": "./dist/storage.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.mjs",
      "require": "./dist/testing.cjs"
    }
  },
  "sideEffects": false,
  "dependencies": {
    "@atproto/api": "^0.17.5",
    "@atproto/lexicon": "^0.5.1",
    "@atproto/oauth-client": "^0.5.10",
    "@atproto/oauth-client-node": "^0.3.12",
    "@hypercerts-org/lexicon": "^0.10.0-beta.3",
    "eventemitter3": "^5.0.1",
    "zod": "^3.24.4"
  }
}
