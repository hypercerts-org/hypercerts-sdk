{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "install": {
      "dependsOn": ["^install"],
      "outputs": ["node_modules/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
