{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "install": {
      "dependsOn": ["^install"],
      "outputs": ["node_modules/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "format:check": {
      "dependsOn": ["^format:check"]
    },
    "check": {
      "dependsOn": ["format:check", "lint", "build", "typecheck", "test"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    }
  }
}
